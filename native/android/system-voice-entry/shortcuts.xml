      android:targetPackage="__PACKAGE__"
      android:targetClass="__PACKAGE__.MainActivity"
      android:data="__SCHEME__://voice-entry?v=1&amp;action=addListItem&amp;entry=shortcut" />
  </shortcut>
  <shortcut
    android:shortcutId="capture_task"
    android:enabled="true"
    android:icon="@mipmap/ic_launcher"
    android:shortcutShortLabel="@string/voice_shortcut_capture_task_short"
    android:shortcutLongLabel="@string/voice_shortcut_capture_task_long">
